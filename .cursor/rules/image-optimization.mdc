## Anti-Patterns

```swift
// ❌ BAD - Manual image processing on main thread
DispatchQueue.main.async {
    let context = CGContext(...)
    context.draw(image, in: rect)  // BLOCKS UI!
    let scaled = context.makeImage()
    view.image = scaled
}

// ✅ GOOD - Let ImageProcessor decode it
ImageProcessor.processImage(image, windowId: id) { decoded in
    view.image = decoded  // GPU scales during display
}

// ❌ BAD - Pre-scaling causes layout shifts
ImageProcessor.processImage(image, windowId: id, targetSize: size) { scaled in
    view.image = scaled  // Size might not match UI calculations!
}

// ❌ BAD - Creating own cache without expiration
var imageCache = [CGWindowID: CGImage]()  // Never cleared!

// ✅ GOOD - Use ImageProcessor's managed cache
ImageProcessor.processImage(...)  // Automatic cache management
```

